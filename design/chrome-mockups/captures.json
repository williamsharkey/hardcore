      "static void expand_home(const char *in, char *out, size_t cap) {                                                                ",
      "    const char *home = getenv(\"HOME\");                                                                                          ",
      "    if (in[0] == '~' && (in[1] == '/' || !in[1]) && home) snprintf(out, cap, \"%s%s\", home, in + 1);                             ",
